{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "type": "heading",
    "icon": "bi-bookmark-fill",
    "label": "Heading",
    "features": [
        "typography",
        "bgColor",
        "bgImage",
        "margin",
        "padding",
        "border",
        "shadow",
        "position",
        "display",
        "htmlAnchor",
        "className",
        "style"
    ],
    "attributes": {
        "tag": {
            "type": "string",
            "default": "h1",
            "rules": ["required", "string", {}]
        },
        "title": {
            "type": "string",
            "default": "",
            "rules": ["nullable", "string", "max:255"]
        },
        "icon": {
            "type": "string",
            "default": "",
            "rules": ["nullable", "string", "max:255"]
        }
    }
}
