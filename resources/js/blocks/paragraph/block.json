{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "type": "paragraph",
    "icon": "bi-paragraph",
    "label": "Paragraph",
    "features": [
        "typography",
        "bgColor",
        "bgImage",
        "margin",
        "padding",
        "border",
        "shadow",
        "position",
        "display",
        "inset",
        "zIndex",
        "htmlAnchor",
        "className",
        "style"
    ],
    "attributes": {
        "content": {
            "type": "string",
            "default": "",
            "rules": ["nullable", "string", "max:255"]
        }
    }
}
